NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_AUTH_PROVIDERS=google,github

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Correos administradores (acceso total). El rol se re-deriva en cada login:
# sacar un correo de aquí lo degrada de inmediato.
FIREBASE_ADMIN_EMAILS=admin@example.com
# Correos del personal autorizado (pueden vender y canjear). Si se deja vacío,
# cualquier cuenta Firebase entra como staff (solo para desarrollo).
FIREBASE_STAFF_EMAILS=staff1@example.com,staff2@example.com
# Exige correo verificado en el proveedor email/password (true por defecto).
FIREBASE_ALLOW_UNVERIFIED_EMAILS=false
FIREBASE_SESSION_COOKIE_NAME=vip-passports-session

# Promoción Blackend Week VIP
PROMO_KEY=blackend-week-vip-2026
PROMO_SALE_START=2026-11-23T00:00:00.000-06:00
PROMO_SALE_END=2026-11-28T23:59:59.999-06:00
PROMO_REDEMPTION_START=2026-12-01T00:00:00.000-06:00
PROMO_REDEMPTION_END=2026-12-31T23:59:59.999-06:00
