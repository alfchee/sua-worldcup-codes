rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isStaffOrAdmin() {
      return hasRole('staff') || hasRole('admin');
    }

    // Todas las operaciones de pasaportes pasan por el Admin SDK (rutas API
    // con verificación de rol en servidor). El cliente nunca escribe directo:
    // así se exigen ventana de venta, validación, unicidad y canje único.
    match /vipPassports/{passportId} {
      allow read, create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasRole('admin'));
      allow write: if hasRole('admin');
    }

    match /auditLogs/{logId} {
      allow read: if hasRole('admin');
      allow write: if hasRole('admin');
    }
  }
}
