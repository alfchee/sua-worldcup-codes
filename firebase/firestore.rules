rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isStaffOrAdmin() {
      return hasRole('staff') || hasRole('admin');
    }

    match /couponCodes/{couponId} {
      allow read: if resource.data.expiresAt > request.time || isStaffOrAdmin();
      allow create, update, delete: if hasRole('admin');
    }

    match /vipPassports/{passportId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin();
      // El canje (update) y el resto de cambios sensibles pasan por el Admin SDK,
      // que verifica el rol en el código de servidor; el cliente no actualiza directo.
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasRole('admin'));
      allow write: if hasRole('admin');
    }

    match /auditLogs/{logId} {
      allow read: if hasRole('admin');
      allow write: if hasRole('admin');
    }
  }
}
